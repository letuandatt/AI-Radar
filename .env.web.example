# Backend only. Copy to .env.web in the repository root.
# Local development: enable the API without exposing it to the network.
WEB_ENABLED=true
WEB_HOST=127.0.0.1
WEB_PORT=8000
WEB_ALLOWED_HOSTS=["127.0.0.1","localhost","[::1]"]
WEB_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
WEB_DOCS_ENABLED=false
WEB_EMAIL_CALLBACKS_ENABLED=false

# Optional local Basic Auth: set both values or leave both empty.
# A configured password must contain at least 16 characters.
# Remote access additionally requires HTTPS termination.
WEB_USERNAME=
WEB_PASSWORD=