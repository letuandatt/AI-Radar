GROQ_API_KEY=
COHERE_API_KEY=

QDRANT_URL=
QDRANT_API_KEY=

ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_ACCESS_TOKEN=
ZALO_WEBHOOK_SECRET=

# Run acquisition immediately on application startup (local dev convenience).
# Default: false — startup only initializes infrastructure; ingestion runs via the scheduled job.
# ACQUISITION_RUN_ON_STARTUP=true

# --- LLM ---
# Provider order and model names. Switching models only requires editing .env.
# LLM_PRIMARY_PROVIDER=ollama
# LLM_FALLBACK_PROVIDERS=["groq"]
# GROQ_MODEL=qwen/qwen3.8-27b
# OLLAMA_MODEL=qwen3:4b
# LLM_DAILY_BUDGET_USD=10
# LLM_ALERT_PERCENT=0.8
# LLM_RATE_LIMIT_RPM=60
# LLM_RATE_LIMIT_WAIT_TIMEOUT=30
# LLM_MAX_CONCURRENT=4
# LLM_BATCH_SIZE=50
# LLM_DAILY_TOKEN_LIMIT=
# LLM_DAILY_REQUEST_LIMIT=

# --- Relevance Gate (deterministic pre-LLM filter) ---
# GATE_ENABLED=true
# GATE_MIN_CONTENT_LENGTH=50
# GATE_MAX_ARTICLE_AGE_DAYS=
# GATE_TOPIC_KEYWORDS=["llm", "agents"]

# --- Storage paths (E2: point at a mounted volume / managed storage in prod) ---
# SQLITE_PATH=app/storage/knowledge/knowledge.db
# BM25_INDEX_PATH=app/storage/search/bm25_index.pkl

# --- Embedding (E3) ---
# EMBEDDING_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434

# --- Daily Digest (D1) ---
# DIGEST_ENABLED=false
# DIGEST_MAX_ITEMS=10